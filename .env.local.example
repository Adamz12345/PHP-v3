# Flutterwave Configuration
# Get your keys from: https://dashboard.flutterwave.com/settings/api-keys

# Public Key (can be exposed to client)
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-your_public_key_here

# Secret Key (NEVER expose to client!)
FLW_SECRET_KEY=FLWSECK_TEST-your_secret_key_here

# Application URL
# Used for redirect_url and webhook configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Example:
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
